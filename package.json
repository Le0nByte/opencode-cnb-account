{
  "name": "opencode-cnb-account",
  "version": "0.3.2",
  "description": "Magpie / OpenCode provider plugin for CNB (cnb.cool): account login, identity badges, credit quota, repo bootstrap and AI relay",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "page",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "cnb",
    "codebuddy"
  ],
  "license": "MIT",
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 4,
    "page": {
      "title": "CNB 账户",
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "titles": {
        "zh": "CNB 账户",
        "zh-TW": "CNB 帳戶",
        "en": "CNB account",
        "ja": "CNB アカウント"
      }
    },
    "panels": [
      {
        "slot": "provider",
        "file": "page/panel.html",
        "title": "CNB 认证与积分"
      }
    ],
    "permissions": [
      "usage:summary"
    ],
    "options": {
      "org": "",
      "repo": "",
      "transport": "auto",
      "relay": {
        "url": "",
        "key": ""
      },
      "claim": {
        "url": "",
        "method": "POST",
        "body": "{}"
      },
      "autoCreateRepo": false,
      "repoName": "code",
      "visibility": "private"
    }
  }
}
